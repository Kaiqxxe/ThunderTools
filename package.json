{
  "name": "thundertools",
  "version": "1.1.1",
  "description": "Ferramentas de manutenção Windows",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start-electron.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "lucide": "^1.16.0"
  },
  "build": {
    "appId": "com.thundertools.app",
    "productName": "ThunderTools",
    "files": [
      "main.js",
      "renderer.js",
      "preload.js",
      "index.html",
      "icon.ico",
      "assets"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ThunderTools"
    }
  }
}
